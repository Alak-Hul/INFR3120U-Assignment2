<!DOCTYPE html>
<html>
  <head>
    <title><%= title %></title>
    <link rel='stylesheet' href='/Content/app.css' />
    <link rel="stylesheet" href="/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="/@fortawesome/fontawesome-free/css/all.min.css"/>
    <script src="/bootstrap/dist/js/bootstrap.min.js"></script>
  </head>
  <body>
    <%- include('partials/header') %>
    <h1><%= title %></h1>
    <p>Welcome to <%= title %></p>
    <article>
        <h2>Feedback ... Stay in touch</h2>
        <form action="mailto:kurtis.stubbe@ontariotechu.net?subject=Feedback on website"
        method="post" enctype="text/plain" name="feedback_form">
            <p>
                <label for="Fname">First Name :</label>
                <input type="text" id="Fname" size="32" placeholder="Enter your first name" required>
            </p>
            <p>
                <label for="Lname">Last Name :</label>
                <input type="text" id="Lname" size="32" placeholder="Enter your last name" required>
            </p>
            <p>
                <label for="email">Email :</label>
                <input type="email" id="email" size="40" placeholder="Enter your email" required>
            </p>
            <p>
                <label for="tel">Phone Number :</label>
                <input type="tel" id="tel" size="28" placeholder="Enter your Phone Number" required>
            </p>
            <p>
                <label for="comments">Comments</label><br>
                <textarea name="comments" cols="60" rows="6" id="comments"></textarea>
            </p>
            <p>
                <input type="checkbox" name="mailist" id="mailist">
                <label for="mailist">Put me on your e-list</label>
            </p>
            <p>
                <label for="where">How did you find us</label>
                <select name="where" id="where">
                    <option value="Search engine">Search Engine</option>
                    <option value="Social Media">Social Media</option>
                    <option value="Words of mouth">Word of mouth</option>
                    <option value="other">Other</option>
                </select>
            </p>
            <p>
                <label for="counteries">Where do you live?</label>
                <input list="counteries">
                <datalist id="counteries">
                    <option value="Afghanistan"> 
                    <option value="Albania"> 
                    <option value="Algeria">
                    <option value="Andorra"> 
                    <option value="Angola">
                    <option value="Antigua and Barbuda">
                    <option value="Argentina"> 
                    <option value="Armenia"> 
                    <option value="Aruba"> 
                    <option value="Australia"> 
                    <option value="Austria"> 
                    <option value="Azerbaijan">
                </datalist>
            </p>
            <p><label for="DoB">What's your birthday?</label>
            <input type="date" name="DoB" id="DoB"></p>
            <input type="reset" value="Reset">
            <input type="submit" value="Submit">
        </form>
    </article>
    <%- include('partials/footer') %>
  </body>
  <script src="/Script/app.js"></script>
</html>
